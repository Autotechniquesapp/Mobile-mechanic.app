# Configure these in Netlify; never put real secrets in GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Netlify UI may already contain these VITE_ names for the browser build.
# The Netlify Functions also accept them as fallbacks.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Preferred server function names.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only. Required for public intake writes.
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=https://mobile-mechanic.app

# Stripe is scaffolded for a later billing milestone.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_SHOP=
STRIPE_PRICE_PRO=
